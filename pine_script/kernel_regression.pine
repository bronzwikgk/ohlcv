//@version=6
indicator("Nadaraya-Watson Kernel Regression [LMW Style]", "NW_LMW", overlay=true)

i_period    = input.int(64, "Lookback Period", minval=2)
i_bandwidth = input.float(8.0, "Bandwidth (h)", minval=0.1, step=0.5)
i_source    = input.source(close, "Source")

// ── NW kernel regression ────────────────────────────────────────────────
nw_kernel_regression(series float src, simple int period, simple float bandwidth) =>
    int    lookback = math.min(bar_index, period - 1)   // safe cap
    float  h2_2     = 2.0 * bandwidth * bandwidth
    float  sum_w    = 0.0
    float  sum_wp   = 0.0
    for i = 0 to lookback
        float d = float(i)
        float w = math.exp(-(d * d) / h2_2)
        float p = nz(src[i], src)      // fall back to current src if na
        sum_w  += w
        sum_wp += w * p
    sum_w > 0 ? sum_wp / sum_w : src

float nw_curve = nw_kernel_regression(i_source, i_period, i_bandwidth)

plot(nw_curve, "NW Kernel Regression", color=color.yellow, linewidth=2)